# Reference copy of the Caddyfile that cloud-init writes to
# /srv/pingvin/Caddyfile on the VPS.
#
# The actual hostname and admin email are templated in by Terraform.
# This copy uses placeholders.

{
    email YOUR_ADMIN_EMAIL
}

YOUR_HOSTNAME {
    encode zstd gzip
    reverse_proxy pingvin:3000

    request_body {
        max_size 50MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}
